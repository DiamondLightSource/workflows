      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (name) (rate(vcluster_syncer_workqueue_retries_total[5m])) / clamp_min(sum by (name) (rate(vcluster_syncer_workqueue_adds_total[5m])), 0.000001)",
          "legendFormat": "{{name}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }

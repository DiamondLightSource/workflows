    {
      "id": 7,
      "type": "timeseries",
      "title": "Host API request rate by method",
      "description": "Non-loopback endpoints are treated as host-cluster APIs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (method) (rate(vcluster_syncer_rest_client_requests_total{host=~\"$host_api\",host!~\"^(127[.]0[.]0[.]1|localhost|[[]?::1[]]?)(:[0-9]+)?$\"}[5m]))",

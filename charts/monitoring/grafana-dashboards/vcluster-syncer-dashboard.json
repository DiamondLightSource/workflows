    {
      "id": 14,
      "type": "timeseries",
      "title": "Retry share of queue additions",
      "description": "Diagnostic ratio. It is not an exact percentage of failed objects.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8

{
  "name": "workflows-graph-proxy",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "graph-proxy",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.linkedProjects": [
          "backend/graph-proxy/Cargo.toml"
        ]
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.4.2": {
      "username": "none",
      "upgradePackages": false
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspace,type=bind",
  "workspaceFolder": "/workspace/",
  "containerEnv": {
    "ARGO_SERVER_URL": "https://argo-workflows.workflows.diamond.ac.uk/",
    "KUBERNETES_API_URL": "https://kubernetes.workflows.diamond.ac.uk/",
    "ARGO_SERVER_SCHEMA_URL": "https://argo-workflows.workflows.diamond.ac.uk/assets/openapi-spec/swagger.json",
    "SESSIONSPACES_API_URL": "http://sessionspaces-api:8081",
    "S3_BUCKET": "k8s-workflows-test",
    "S3_ENDPOINT_URL": "https://sci-nas-s3.diamond.ac.uk",
    // Connects to 'popup' monitoring stack. No issue if the endpoint can't be found
    "METRICS_ENDPOINT": "http://localhost:4318/v1/metrics",
    "WORKFLOWS_DEV_CONTAINER": "true",
    // Submission tests build very large debug futures; the default test-thread
    // stack overflows without this.
    "RUST_MIN_STACK": "16777216"
  },
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": { "label": "SessionSpaces API" }
  },
  "postCreateCommand": "echo \"source /usr/share/bash-completion/completions/git\" >> ~/.bashrc"
}
